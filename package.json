{
  "name": "clawdeploy",
  "version": "1.0.0",
  "private": true,
  "description": "ClawDeploy — AI Bot Deployment Platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @clawdeploy/api db:generate",
    "db:migrate": "pnpm --filter @clawdeploy/api db:migrate",
    "db:push": "pnpm --filter @clawdeploy/api db:push"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
